APP_ADDR=127.0.0.1:8088
DATABASE_PATH=data/clovergo.db
LIBRARY_DIR=data/library
MAX_UPLOAD_MB=10
# Longest material, in characters, summarized and extracted in one call.
MAX_DOCUMENT_RUNES=200000

# Volcano Ark is the only external AI service used by CloverGo.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_MODEL=deepseek-v4-1-flash-260910
ARK_TIMEOUT_SECONDS=240

# Optional semantic search. Leave empty for keyword-only search. Tested with
# doubao-embedding-vision-251215 through /embeddings/multimodal.
ARK_EMBEDDING_MODEL=
ARK_EMBEDDING_DIMENSIONS=1024

# Extracted knowledge the model scores below this confidence is dropped.
AUTO_PUBLISH_MIN_CONFIDENCE=0.72

# Optional: WeChat Official Account, for pushing drafts into its draft box.
# The server's public IP must be on the account's API IP allowlist.
# Default push saves a draft; explicitly choosing Push and publish submits it.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_AUTHOR=
# Optional default cover (a permanent image material media_id). Without it,
# every push needs a cover image upload.
WECHAT_THUMB_MEDIA_ID=
# Optional socks5://user:password@host:port; the push then leaves from the
# proxy, so the allowlist needs the proxy's egress IP instead of this machine's.
WECHAT_PROXY_URL=
